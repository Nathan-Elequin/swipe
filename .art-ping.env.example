# Cursor automation "Swipe art request" webhook (https://cursor.com/automations).
# art-handoff.mdc: this replaces Pixel's paused Grok Bot art-request ping.
# After you save the automation, copy the webhook URL and API key into gitignored
# .art-ping.env — never commit that file. Keys stay ART_PING_URL and ART_PING_KEY.
# tools/request_art.ps1 POSTs JSON with Authorization: Bearer <ART_PING_KEY>.
# ART_PING_URL=<webhook URL from the automation after save>
# ART_PING_KEY=<webhook API key>
ART_PING_URL=
ART_PING_KEY=
